generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & RBAC ====================

enum UserRole {
  SUPER_ADMIN
  MANAGING_PARTNER
  LAWYER
  PARALEGAL
  SECRETARY
  ACCOUNTANT
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  role          UserRole  @default(LAWYER)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  caseAssignments  CaseAssignment[]
  documents        Document[]
  tasksAssigned    Task[]           @relation("TaskAssignee")
  tasksCreated     Task[]           @relation("TaskCreator")
  casesCreated     Case[]           @relation("CaseCreator")
  timeEntries      TimeEntry[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  events           Event[]
  passwordResets   PasswordResetToken[]
  team             Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId           String?
  legalServices    UserLegalService[]

  @@index([email])
  @@index([role])
  @@index([teamId])
  @@map("users")
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[]
  documents Document[]
  events    Event[]
  tasks     Task[]
  cases     Case[]

  @@map("teams")
}

model LegalService {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserLegalService[]

  @@map("legal_services")
}

model UserLegalService {
  userId         String
  legalServiceId String
  assignedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalService LegalService @relation(fields: [legalServiceId], references: [id], onDelete: Cascade)

  @@id([userId, legalServiceId])
  @@index([legalServiceId])
  @@map("user_legal_services")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ==================== CLIENTS ====================

enum ClientType {
  INDIVIDUAL
  CORPORATE
}

model Client {
  id          String     @id @default(cuid())
  firstName   String
  lastName    String
  companyName String?
  email       String
  phone       String?
  address     String?    @db.Text
  clientType  ClientType @default(INDIVIDUAL)
  notes       String?    @db.Text
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  cases    Case[]
  invoices Invoice[]

  @@index([email])
  @@index([lastName, firstName])
  @@index([isArchived])
  @@map("clients")
}

// ==================== CASES ====================

enum CaseStatus {
  NEW
  ACTIVE
  PENDING
  IN_COURT
  SETTLED
  CLOSED
}

enum CaseCategory {
  CIVIL
  CRIMINAL
  CORPORATE
  FAMILY
  REAL_ESTATE
  INTELLECTUAL_PROPERTY
  LABOR
  TAX
  OTHER
}

model Case {
  id          String             @id @default(cuid())
  caseNumber  String             @unique
  title       String
  description String?            @db.Text
  category    CaseCategory       @default(OTHER)
  courtName   String?
  filingDate  DateTime?
  status      CaseStatus         @default(NEW)
  visibility  DocumentVisibility @default(GENERAL)
  clientId    String
  createdById String?
  teamId      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  client      Client           @relation(fields: [clientId], references: [id])
  createdBy   User?            @relation("CaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignments CaseAssignment[]
  documents   Document[]
  tasks       Task[]
  timeEntries TimeEntry[]
  events      Event[]
  notes       CaseNote[]
  invoiceItems InvoiceItem[]

  @@index([caseNumber])
  @@index([status])
  @@index([clientId])
  @@index([visibility])
  @@index([teamId])
  @@index([createdById])
  @@map("cases")
}

model CaseAssignment {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  isLead    Boolean  @default(false)
  assignedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
  @@map("case_assignments")
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  content   String   @db.Text
  createdBy String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_notes")
}

// ==================== DOCUMENTS ====================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]

  @@map("categories")
}

enum DocumentVisibility {
  GENERAL
  TEAM
}

model Document {
  id           String             @id @default(cuid())
  fileName     String
  fileType     String
  fileSize     Int
  storageUrl   String
  categoryId   String
  visibility   DocumentVisibility @default(GENERAL)
  version      Int                @default(1)
  parentId     String?
  caseId       String
  uploadedById String
  teamId       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  case       Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  team       Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent     Document?  @relation("DocumentVersions", fields: [parentId], references: [id])
  versions   Document[] @relation("DocumentVersions")

  @@index([caseId])
  @@index([fileName])
  @@index([categoryId])
  @@index([visibility])
  @@index([teamId])
  @@map("documents")
}

// ==================== TASKS ====================

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id          String             @id @default(cuid())
  title       String
  description String?            @db.Text
  status      TaskStatus         @default(TODO)
  priority    TaskPriority       @default(MEDIUM)
  visibility  DocumentVisibility @default(GENERAL)
  dueDate     DateTime?
  caseId      String?
  assigneeId  String?
  createdById String
  teamId      String?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  case      Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id])
  team      Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([visibility])
  @@index([teamId])
  @@map("tasks")
}

// ==================== CALENDAR & EVENTS ====================

enum EventType {
  HEARING
  MEETING
  COURT_APPEARANCE
  DEADLINE
  REMINDER
}

model Event {
  id              String             @id @default(cuid())
  title           String
  description     String?            @db.Text
  type            EventType          @default(MEETING)
  startTime       DateTime
  endTime         DateTime
  location        String?
  isAllDay        Boolean            @default(false)
  visibility      DocumentVisibility @default(GENERAL)
  caseId          String?
  userId          String
  teamId          String?
  reminderMinutes Int?               @default(60)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id])
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([startTime])
  @@index([caseId])
  @@index([visibility])
  @@index([teamId])
  @@map("events")
}

// ==================== BILLING ====================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model TimeEntry {
  id        String   @id @default(cuid())
  caseId    String
  userId    String
  hours     Decimal  @db.Decimal(10, 2)
  rate      Decimal  @db.Decimal(10, 2)
  notes     String?  @db.Text
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([caseId])
  @@index([userId])
  @@map("time_entries")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  amount        Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  notes         String?       @db.Text
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client Client        @relation(fields: [clientId], references: [id])
  items  InvoiceItem[]
  payments Payment[]

  @@index([invoiceNumber])
  @@index([status])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)
  caseId      String?
  timeEntryId String?

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  case      Case?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now())
  paymentMethod String?
  reference     String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ==================== ACTIVITY LOGS ====================

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  HEARING_REMINDER
  TASK_DEADLINE
  INVOICE_DUE
  CASE_ASSIGNMENT
  GENERAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
